rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcı profilleri: Giriş yapmış herkes okuyabilir (lig, podyum ve kulüp sıralaması için), sadece sahibi yazabilir
    match /users/{userId} {
      allow read: if request.auth != null;
      // İstemci-taraflı kalkan: Tek yazmada aşırı altın veya stat manipülasyonuna karşı temel tavan sınırı.
      // BİLİNEN BOŞLUK (Known Loophole): İstemci art arda çok sayıda istek atarak kümülatif olarak bu tavanı aşabilir.
      // Kesin ve mutlak çözüm için Firebase Cloud Function ile sunucu-taraflı seans doğrulama uygulanmalıdır.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gold']) || request.resource.data.gold <= resource.data.gold + 100);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /quests/{questId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pomodoroSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId
          && (!request.resource.data.keys().hasAll(['workMinutes', 'xpEarned']) || request.resource.data.xpEarned <= request.resource.data.workMinutes * 4);
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Kulüpler: Giriş yapmış tüm kullanıcılar okuyabilir, kulüp oluşturabilir ve üye olabilir
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
