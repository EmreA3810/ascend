rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcı profilleri: Giriş yapmış herkes okuyabilir (lig, podyum ve kulüp sıralaması için), sadece sahibi yazabilir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /quests/{questId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pomodoroSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Kulüpler: Giriş yapmış tüm kullanıcılar okuyabilir, kulüp oluşturabilir ve üye olabilir
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
